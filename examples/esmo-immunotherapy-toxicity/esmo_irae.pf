/** PROforma version 1.9 (plain text) **/

/** IMPORTANT: Keep all your comments below the engine_version line **/
engine_version :: '1.9' ;

metadata  :: 'esmo_irae' ;
     title :: 'Management of toxicities from immunotherapy: ESMO Clinical Practice Guidelines (2017)' ;
     desc :: 'Baseline assessment, surveillance and grade-based management of immune-related adverse events (irAEs) from immune checkpoint inhibitors (ICPi), following Table 2 and the management algorithms of the ESMO guideline. Evidence levels/grades of recommendation in brackets.' ;
     version :: '1.0' ;
     author :: 'Derived from Haanen et al., Ann Oncol 2017;28(Suppl 4):iv119-iv142' ;
end metadata.

metaprops :: '' ;

plan  :: 'esmo_irae' ;
     caption :: 'Management of toxicities from immunotherapy: ESMO Clinical Practice Guidelines (2017)' ;
     component :: 'baseline_assessment' ;
          task_definition :: 'baseline_assessment' ;
          ltwh :: 40,40,0,0;
     component :: 'patient_education' ;
          task_definition :: 'patient_education' ;
          schedule_constraint :: completed('baseline_assessment') ;
          ltwh :: 40,140,0,0;
     component :: 'irae_surveillance' ;
          task_definition :: 'irae_surveillance' ;
          schedule_constraint :: completed('patient_education') ;
          cycle_until ::follow_up_ended = "yes";
          ltwh :: 40,240,0,0;
end plan.

enquiry  :: 'baseline_assessment' ;
     caption :: 'Patient selection and baseline assessment' ;
     description :: 'Before treatment: patient and family history, general physical condition, autoimmune diseases, baseline laboratory tests (incl. TSH, FT4, cortisol, glucose, liver and renal function) and radiology (CT chest/abdomen/pelvis, often brain MRI). Patients with autoimmune disease or prior irAEs are at higher risk.' ;
     source :: 'autoimmune_history' ;
          data_definition :: 'autoimmune_history' ;
     source :: 'icpi_regimen' ;
          data_definition :: 'icpi_regimen' ;
     source :: 'prior_irae' ;
          data_definition :: 'prior_irae' ;
end enquiry.

action  :: 'patient_education' ;
     caption :: 'Inform patient about potential irAEs' ;
     procedure :: 'Inform the patient about potential adverse events before starting treatment; symptoms must be reported directly to the treating team so that work-up and action can start promptly.' ;
end action.

enquiry  :: 'toxicity_assessment' ;
     caption :: 'Assess and grade toxicities (CTCAE)' ;
     description :: 'At every visit / before every infusion: symptoms, examination and blood tests (LFTs, TFTs, glucose, creatinine, electrolytes); exclude other causes (infection, disease progression, other drugs).' ;
     source :: 'arthralgia_grade' ;
          data_definition :: 'arthralgia_grade' ;
     source :: 'diabetes_grade' ;
          data_definition :: 'diabetes_grade' ;
     source :: 'diarrhoea_grade' ;
          data_definition :: 'diarrhoea_grade' ;
     source :: 'follow_up_ended' ;
          data_definition :: 'follow_up_ended' ;
     source :: 'gbs_or_myasthenia' ;
          data_definition :: 'gbs_or_myasthenia' ;
     source :: 'hepatitis_grade' ;
          data_definition :: 'hepatitis_grade' ;
     source :: 'hypophysitis_severity' ;
          data_definition :: 'hypophysitis_severity' ;
     source :: 'myocarditis_suspected' ;
          data_definition :: 'myocarditis_suspected' ;
     source :: 'nephritis_grade' ;
          data_definition :: 'nephritis_grade' ;
     source :: 'neuro_severity' ;
          data_definition :: 'neuro_severity' ;
     source :: 'pneumonitis_grade' ;
          data_definition :: 'pneumonitis_grade' ;
     source :: 'skin_grade' ;
          data_definition :: 'skin_grade' ;
     source :: 'thyroid_status' ;
          data_definition :: 'thyroid_status' ;
     source :: 'thyroid_symptomatic' ;
          data_definition :: 'thyroid_symptomatic' ;
end enquiry.

decision  :: 'skin_management' ;
     caption :: 'Skin toxicity by grade' ;
     candidate :: 'skin_continue' ;
          caption :: 'Continue ICPi with topical treatment' ;
          argument :: for,skin_grade <= 2 attributes
               caption :: 'Grade 1-2: continue ICPi (check weekly); topical emollients, antihistamines and/or topical corticosteroid creams; reinitiate ICPi when <= grade 1' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'skin_interrupt' ;
          caption :: 'Interrupt ICPi, potent topical steroids' ;
          argument :: for,skin_grade = 3 attributes
               caption :: 'Grade 3: interrupt ICPi and start topical emollients, antihistamines and high-strength corticosteroid creams [II, B]' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'skin_discontinue' ;
          caption :: 'Discontinue ICPi, i.v. steroids, dermatology' ;
          argument :: for,skin_grade = 4 attributes
               caption :: 'Grade 4: discontinue ICPi (permanently), consider admission, consult dermatologist immediately, i.v. (methyl)prednisolone 1-2 mg/kg [II, B]' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
end decision.

action  :: 'skin_topical' ;
     caption :: 'Topical treatment, continue ICPi' ;
     precondition ::result_of(skin_management) = skin_continue;
     procedure :: 'Avoid skin irritants and sun exposure; topical emollients; mild (G1) or moderate/potent (G2) topical steroids; oral or topical antihistamines for itch; continue ICPi.' ;
end action.

action  :: 'skin_grade3' ;
     caption :: 'Withhold ICPi; potent topical steroids' ;
     precondition ::result_of(skin_management) = skin_interrupt;
     procedure :: 'Withhold ICPi; potent topical steroids; systemic prednisolone 0.5-1 mg/kg (i.v. if severe) weaned over 1-4 weeks; dermatology review, consider biopsy; recommence ICPi at G1 after discussion.' ;
end action.

action  :: 'skin_grade4' ;
     caption :: 'Admit; i.v. (methyl)prednisolone 1-2 mg/kg' ;
     precondition ::result_of(skin_management) = skin_discontinue;
     procedure :: 'Permanently discontinue ICPi; admit under dermatology supervision; i.v. (methyl)prednisolone 1-2 mg/kg tapered when toxicity resolves; urgent dermatology review, punch biopsy, clinical photography.' ;
end action.

plan  :: 'skin_toxicity' ;
     caption :: 'Immune-related skin toxicity' ;
     precondition ::skin_grade >= 1;
     component :: 'skin_management' ;
          task_definition :: 'skin_management' ;
          ltwh :: 40,40,0,0;
     component :: 'skin_topical' ;
          task_definition :: 'skin_topical' ;
          schedule_constraint :: completed('skin_management') ;
          ltwh :: 40,140,0,0;
     component :: 'skin_grade3' ;
          task_definition :: 'skin_grade3' ;
          schedule_constraint :: completed('skin_management') ;
          ltwh :: 40,240,0,0;
     component :: 'skin_grade4' ;
          task_definition :: 'skin_grade4' ;
          schedule_constraint :: completed('skin_management') ;
          ltwh :: 40,340,0,0;
end plan.

decision  :: 'endocrine_management' ;
     caption :: 'Endocrinopathy management' ;
     choice_mode :: multiple ;
     candidate :: 'hyperthyroid_treatment' ;
          caption :: 'Beta-blocker for symptomatic hyperthyroidism' ;
          argument :: for,thyroid_status = "hyperthyroid" and thyroid_symptomatic = "yes" attributes
               caption :: 'Symptomatic hyperthyroidism (usually G1-2): interrupt ICPi, start propranolol or atenolol/metoprolol; restart ICPi when asymptomatic [IV-V, B]' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'hypothyroid_hrt' ;
          caption :: 'Thyroid hormone replacement' ;
          argument :: for,thyroid_status = "hypothyroid" attributes
               caption :: 'Hypothyroidism: start levothyroxine 50-100 ug/day depending on severity, increase until TSH is normal [IV-V, B]' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'hypophysitis_steroids' ;
          caption :: 'High-dose steroids and HRT for hypophysitis' ;
          argument :: for,hypophysitis_severity = "moderate" or hypophysitis_severity = "severe" attributes
               caption :: 'Hypophysitis with headache, diplopia or other neurological symptoms: (methyl)prednisolone 1 mg/kg, taper over 2-4 weeks; HRT for the affected axes [V, B]' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'hypophysitis_hrt' ;
          caption :: 'Hormone replacement, continue ICPi' ;
          argument :: for,hypophysitis_severity = "mild" attributes
               caption :: 'Vague symptoms or asymptomatic: replace cortisol and/or thyroxine as needed and continue ICPi with appropriate HRT (Figure 6)' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'diabetes_insulin' ;
          caption :: 'Insulin for new-onset type 1 diabetes' ;
          argument :: for,diabetes_grade >= 1 attributes
               caption :: 'New-onset type 1 DM: start insulin; grade 3-4 (ketoacidosis): admit immediately [I, A]. Corticosteroids are not recommended' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
end decision.

action  :: 'beta_blocker' ;
     caption :: 'Interrupt ICPi; beta-blocker' ;
     precondition ::result_set(endocrine_management) includes "hyperthyroid_treatment";
     procedure :: 'Interrupt ICPi; propranolol or atenolol/metoprolol; restart ICPi when asymptomatic. Rarely carbimazole or steroids are needed.' ;
end action.

action  :: 'levothyroxine' ;
     caption :: 'Start levothyroxine' ;
     precondition ::result_set(endocrine_management) includes "hypothyroid_hrt";
     procedure :: 'Levothyroxine 50-100 ug/day (0.5-1.5 ug/kg; start low in elderly or cardiac history), titrate to normal TSH; continue ICPi. Prednisolone 1 mg/kg for painful thyroiditis.' ;
end action.

action  :: 'hypophysitis_high_dose' ;
     caption :: 'Withhold ICPi; (methyl)prednisolone 1 mg/kg' ;
     precondition ::result_set(endocrine_management) includes "hypophysitis_steroids";
     procedure :: 'Withhold ICPi; send pituitary axis bloods, then (methyl)prednisolone 1 mg/kg (i.v. if severe mass effect or hypoadrenalism); MRI pituitary, visual fields; endocrinology; wean to replacement dose over 2-4 weeks; sick-day rules.' ;
end action.

action  :: 'hypophysitis_replacement' ;
     caption :: 'Hormone replacement, continue ICPi' ;
     precondition ::result_set(endocrine_management) includes "hypophysitis_hrt";
     procedure :: 'Replace cortisol (hydrocortisone 20/10/10 mg if 9am cortisol low) and/or thyroxine; continue ICPi with HRT; MRI pituitary; refer to endocrinology; patient education (alert card).' ;
end action.

action  :: 'insulin_treatment' ;
     caption :: 'Start insulin' ;
     precondition ::result_set(endocrine_management) includes "diabetes_insulin";
     procedure :: 'Start insulin; admit if ketoacidotic (G3-4) and treat per local DKA guidelines; measure C-peptide, anti-GAD and islet cell antibodies; restart ICPi once regulated.' ;
end action.

plan  :: 'endocrine_toxicity' ;
     caption :: 'Immune-related endocrinopathies' ;
     precondition ::thyroid_status != "normal" or hypophysitis_severity != "none" or diabetes_grade >= 1;
     component :: 'endocrine_management' ;
          task_definition :: 'endocrine_management' ;
          ltwh :: 40,40,0,0;
     component :: 'beta_blocker' ;
          task_definition :: 'beta_blocker' ;
          schedule_constraint :: completed('endocrine_management') ;
          ltwh :: 40,140,0,0;
     component :: 'levothyroxine' ;
          task_definition :: 'levothyroxine' ;
          schedule_constraint :: completed('endocrine_management') ;
          ltwh :: 40,240,0,0;
     component :: 'hypophysitis_high_dose' ;
          task_definition :: 'hypophysitis_high_dose' ;
          schedule_constraint :: completed('endocrine_management') ;
          ltwh :: 40,340,0,0;
     component :: 'hypophysitis_replacement' ;
          task_definition :: 'hypophysitis_replacement' ;
          schedule_constraint :: completed('endocrine_management') ;
          ltwh :: 40,440,0,0;
     component :: 'insulin_treatment' ;
          task_definition :: 'insulin_treatment' ;
          schedule_constraint :: completed('endocrine_management') ;
          ltwh :: 40,540,0,0;
end plan.

decision  :: 'hepatitis_management' ;
     caption :: 'Hepatitis by grade' ;
     candidate :: 'hep_continue' ;
          caption :: 'Continue ICPi, repeat LFTs' ;
          argument :: for,hepatitis_grade = 1 attributes
               caption :: 'Grade 1 (ALT/AST > ULN-3x ULN): continue treatment; repeat LFTs in 1 week' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'hep_withhold' ;
          caption :: 'Withhold ICPi, close LFT monitoring' ;
          argument :: for,hepatitis_grade = 2 attributes
               caption :: 'Grade 2: withhold ICPi and monitor AST/ALT 1-2 times per week; if no improvement after 1 week start (methyl)prednisolone 0.5-1 mg/kg [IV-V, B]' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'hep_discontinue' ;
          caption :: 'Discontinue ICPi, steroids 1-2 mg/kg' ;
          argument :: for,hepatitis_grade = 3 attributes
               caption :: 'Grade 3: discontinue ICPi and start (methyl)prednisolone 1-2 mg/kg; add MMF 1000 mg 3x daily if no improvement in 2-3 days [IV-V, B]' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'hep_permanent' ;
          caption :: 'Permanently discontinue, admit, i.v. steroids' ;
          argument :: for,hepatitis_grade = 4 attributes
               caption :: 'Grade 4: permanently discontinue ICPi, admit, i.v. (methyl)prednisolone 2 mg/kg; add MMF if no improvement in 2-3 days; consult hepatologist [IV-V, B]' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
end decision.

action  :: 'hep_grade1' ;
     caption :: 'Continue ICPi; repeat LFTs in 1 week' ;
     precondition ::result_of(hepatitis_management) = hep_continue;
     procedure :: 'Continue ICPi; if ALT/AST > ULN-3x ULN repeat in 1 week.' ;
end action.

action  :: 'hep_grade2' ;
     caption :: 'Withhold ICPi; LFTs 1-2x weekly' ;
     precondition ::result_of(hepatitis_management) = hep_withhold;
     procedure :: 'Withhold ICPi; recheck LFTs/INR/albumin every 3 days; review medication and alcohol; liver screen (hepatitis A/B/C, E, autoantibodies); if rising or no improvement after 1 week start oral prednisolone 0.5-1 mg/kg; resume ICPi after taper when prednisolone <= 10 mg.' ;
end action.

action  :: 'hep_grade3' ;
     caption :: 'Discontinue ICPi; (methyl)prednisolone 1-2 mg/kg' ;
     precondition ::result_of(hepatitis_management) = hep_discontinue;
     procedure :: 'Discontinue ICPi; (methyl)prednisolone 1-2 mg/kg; daily LFTs/INR/albumin, ultrasound with Doppler; add MMF 1000 mg 3x daily if no improvement in 2-3 days; taper over 4-6 weeks.' ;
end action.

action  :: 'hep_grade4' ;
     caption :: 'Admit; i.v. (methyl)prednisolone 2 mg/kg' ;
     precondition ::result_of(hepatitis_management) = hep_permanent;
     procedure :: 'Permanently discontinue ICPi; admit; i.v. (methyl)prednisolone 2 mg/kg; add MMF if no improvement in 2-3 days; hepatology consult, consider liver biopsy; ATG or tacrolimus if refractory; taper over 6 weeks.' ;
end action.

plan  :: 'hepatotoxicity' ;
     caption :: 'Immune-related hepatotoxicity' ;
     precondition ::hepatitis_grade >= 1;
     component :: 'hepatitis_management' ;
          task_definition :: 'hepatitis_management' ;
          ltwh :: 40,40,0,0;
     component :: 'hep_grade1' ;
